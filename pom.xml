<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-model-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.jclaw</groupId>
  <artifactId>jclaw-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>jclaw</name>
  <description>Java/Spring Boot clone of the IronClaw harness: hexagonal agent OS, pure functional core.</description>

  <!-- Inherited by every module, so each artifact declares its own licence rather than relying
       on a LICENSE file that does not travel inside a jar. -->
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <!-- Pure-Java WebAssembly runtime: no native library, so the native image keeps working.
         Endive is Chicory rehomed under the Bytecode Alliance — same codebase, same API, new
         coordinates. Its default engine is still the pure-Java interpreter; the `redline`
         backend that ships native binaries is experimental and opt-in, and enabling it would
         cost exactly the property this dependency was chosen for. -->
    <endive.version>1.1.0</endive.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <picocli.version>4.7.7</picocli.version>
    <anthropic.sdk.version>2.62.0</anthropic.sdk.version>
    <archunit.version>1.5.0</archunit.version>
    <jline.version>4.4.5</jline.version>
    <!-- Native image: the GraalVM toolchain is JDK 25+, while we target release 21 bytecode. -->
    <native.maven.plugin.imageName>jclaw</native.maven.plugin.imageName>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- Static analysis, used only by the `analysis` profile at the bottom of this file. -->
    <spotbugs.plugin.version>4.10.4.1</spotbugs.plugin.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <pmd.plugin.version>3.28.0</pmd.plugin.version>
    <pmd.version>7.27.0</pmd.version>
  </properties>

  <modules>
    <module>jclaw-ports</module>
    <module>jclaw-domain</module>
    <module>jclaw-application-authority</module>
    <module>jclaw-application-usecase</module>
    <module>jclaw-adapter-out-model</module>
    <module>jclaw-adapter-out-capability</module>
    <module>jclaw-adapter-out-persistence</module>
    <module>jclaw-bootstrap</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!--
        Testcontainers, for the PostgreSQL tests. Its own BOM rather than pinned versions, so the
        modules cannot drift apart. Boot 4.1 does not manage these coordinates.
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>run.endive</groupId>
        <artifactId>runtime</artifactId>
        <version>${endive.version}</version>
      </dependency>
      <dependency>
        <groupId>run.endive</groupId>
        <artifactId>wasm</artifactId>
        <version>${endive.version}</version>
      </dependency>
      <!-- jclaw modules -->
      <dependency><groupId>io.jclaw</groupId><artifactId>jclaw-ports</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jclaw</groupId><artifactId>jclaw-domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jclaw</groupId><artifactId>jclaw-application-authority</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jclaw</groupId><artifactId>jclaw-application-usecase</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jclaw</groupId><artifactId>jclaw-adapter-out-model</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jclaw</groupId><artifactId>jclaw-adapter-out-capability</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jclaw</groupId><artifactId>jclaw-adapter-out-persistence</artifactId><version>${project.version}</version></dependency>

      <!-- third-party not covered by the Boot BOM -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli-spring-boot-starter</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <!-- Official Anthropic SDK. Confined to the anthropic adapter in jclaw-adapter-out-model so the
           rest of the harness stays free of any provider's types. -->
      <dependency>
        <groupId>com.anthropic</groupId>
        <artifactId>anthropic-java</artifactId>
        <version>${anthropic.sdk.version}</version>
      </dependency>
      <!-- Terminal line editing for the REPL. The focused artifacts, not the 'jline' uber jar,
           which drags in sshd and a chardet library the harness has no use for. -->
      <dependency>
        <groupId>org.jline</groupId>
        <artifactId>jline-reader</artifactId>
        <version>${jline.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jline</groupId>
        <artifactId>jline-terminal-jni</artifactId>
        <version>${jline.version}</version>
        <scope>runtime</scope>
      </dependency>
      <!-- Machine-checks the layer matrix the package-info files describe. Test scope only. -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- Annotation processor: emits GraalVM reflect/resource config for @Command types. -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli-codegen</artifactId>
        <version>${picocli.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        Coverage, in the default build rather than behind a flag: a number that only exists when
        somebody remembers to ask for it is a number nobody looks at. The agent costs a few
        seconds on a full run, and `-Djacoco.skip=true` turns it off.

        `prepare-agent` sets the `argLine` property that surefire passes to the forked JVM. Anything
        that sets `argLine` on the command line replaces it and silently produces an empty report —
        `-DargLine=...` becomes `-Djacoco.skip=true -DargLine=...` or it becomes no coverage at all.

        Per-module reports land in `<module>/target/site/jacoco`; the whole-tree number comes from
        `report-aggregate` in jclaw-bootstrap, which is the one module that depends on every other.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <compilerArgs>
              <!-- Records + sealed hierarchies are the vocabulary here; keep parameter
                   names so Jackson and Spring can bind without extra annotations. -->
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <!--
    Opt-in static analysis: `mvn -Panalysis verify`. Deliberately a profile rather than part of
    the default build. These tools are slow, they are the kind of dependency that breaks on a new
    JDK, and a developer running `mvn test` wants the tests. CI can ask for them by name.

    Three layers, because they see different things:
      javac -Xlint  the compiler's own opinion, free and always current with the language
      SpotBugs      bytecode patterns, plus FindSecBugs for the injection/crypto families
      PMD           source patterns the compiler has no opinion about, including dead code
  -->
  <profiles>
    <profile>
      <!-- Config paths use ${session.executionRootDirectory} — the directory mvn was invoked
           from — because a relative path would resolve per module, and the obvious
           ${maven.multiModuleProjectDirectory} silently resolves to $HOME without a .mvn
           directory at the root. Run these from the repository root. -->
      <id>analysis</id>
      <properties>
        <!-- -Djclaw.failOnWarning=false to see the whole list while working through one. -->
        <jclaw.failOnWarning>true</jclaw.failOnWarning>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <showWarnings>true</showWarnings>
              <!-- The tree compiles clean under the lint set below, so a new warning is a
                   regression rather than background noise. Opt-in, because a dependency upgrade
                   should not be able to fail `mvn test` on a deprecation — and overridable with
                   -Djclaw.failOnWarning=false while working through one. -->
              <failOnWarning>${jclaw.failOnWarning}</failOnWarning>
              <compilerArgs>
                <arg>-parameters</arg>
                <!-- Everything except `serial` (nothing here is serialized) and `processing`
                     (the picocli annotation processor is expected to claim nothing). -->
                <arg>-Xlint:all,-serial,-processing</arg>
              </compilerArgs>
            </configuration>
          </plugin>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>${spotbugs.plugin.version}</version>
            <configuration>
              <effort>Max</effort>
              <threshold>Low</threshold>
              <includeTests>false</includeTests>
              <excludeFilterFile>${session.executionRootDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
              <plugins>
                <plugin>
                  <groupId>com.h3xstream.findsecbugs</groupId>
                  <artifactId>findsecbugs-plugin</artifactId>
                  <version>${findsecbugs.version}</version>
                </plugin>
              </plugins>
            </configuration>
            <executions>
              <execution>
                <goals><goal>check</goal></goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <version>${pmd.plugin.version}</version>
            <configuration>
              <rulesets>
                <ruleset>${session.executionRootDirectory}/config/pmd-ruleset.xml</ruleset>
              </rulesets>
              <includeTests>false</includeTests>
              <printFailingErrors>true</printFailingErrors>
              <failOnViolation>true</failOnViolation>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>net.sourceforge.pmd</groupId>
                <artifactId>pmd-core</artifactId>
                <version>${pmd.version}</version>
              </dependency>
              <dependency>
                <groupId>net.sourceforge.pmd</groupId>
                <artifactId>pmd-java</artifactId>
                <version>${pmd.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <goals><goal>check</goal></goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>

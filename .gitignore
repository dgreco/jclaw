# --- Maven build output ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- Examples ---
# Following examples/wasm-wordcount/README.md in a clone drops these at the root: a publisher
# keypair from `extensions keygen` and the sample file. *.key below already covers the private
# half, but the public half and the sample would otherwise be staged by a plain `git add -A`,
# and a committed signing keypair is worth one line of prevention.
/keys/
/sample.txt

# build.sh lays out an installable package here; it is entirely derived from src/ and the
# manifest, and module.wasm is a build artefact like any other.
examples/*/dist/

# --- GraalVM native image ---
# The captured Anthropic SDK metadata under src/main/resources/META-INF/native-image is
# deliberately versioned; only build artefacts are ignored.
*.build_artifacts.txt
jclaw-app/jclaw
jclaw-app/*.dylib
jclaw-app/*.so

# --- Java ---
*.class
*.log
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# --- IDEs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
*.swp
*~

# --- OS ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Local tooling state ---
# Claude Code: personal permission overrides are local; project settings would be settings.json.
.claude/settings.local.json
# byte-verify manifest is machine-local state
.byte-manifest

# --- Secrets and runtime state (never commit) ---
.env
.env.*
*.pem
*.key
.jclaw/

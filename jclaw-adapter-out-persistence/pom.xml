<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemalocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-model-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jclaw</groupId>
    <artifactId>jclaw-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../</relativePath>
  </parent>
  <artifactId>jclaw-adapter-out-persistence</artifactId>
  <name>jclaw-adapter-out-persistence</name>
  <description>JSONL event/audit/checkpoint stores, JdbcClient repositories, migrations, H2 default, Postgres profile, FTS and vector indexes.</description>
  <dependencies>
    <dependency>
      <groupId>io.jclaw</groupId>
      <artifactId>jclaw-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jclaw</groupId>
      <artifactId>jclaw-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jclaw</groupId>
      <artifactId>jclaw-application-authority</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
    <!--
      The connection pool. Boot manages the version; without it every JDBC call opened and closed
      its own connection, which is fine for a CLI and wrong for `serve`, where several runs
      execute at once and a PostgreSQL connection costs a round trip and a backend process.
    -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Logging facade only. The binding (logback) is contributed by jclaw-bootstrap; in tests
         SLF4J's no-op fallback applies. Keeps this module framework-free while letting it
         narrate the pipeline at DEBUG/TRACE for trace-mode runs. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
